{
    "name": "dsh-plugins",
    "private": true,
    "description": "DSH plugin monorepo: deepseek-harness plugins",
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "check": "bun run scripts/check-host-pins.mjs",
        "check:pins": "bun run scripts/check-host-pins.mjs",
        "check:secrets": "bun run scripts/check-secrets.mjs",
        "fix:pins": "bun run scripts/check-host-pins.mjs --fix",
        "build": "bun run --filter '*' build",
        "typecheck": "bun run --filter '*' typecheck",
        "test": "bun run check:pins && bun run check:secrets && bun run --filter '*' test",
        "verify": "bun run check:pins && bun run check:secrets && bun run --filter '*' typecheck && bun run --filter '*' build && bun run --filter '*' test"
    },
    "packageManager": "bun@1.4.5",
    "trustedDependencies": [
        "esbuild"
    ]
}
