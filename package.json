{
    "name": "dsh-plugins",
    "private": true,
    "description": "DSH plugin monorepo: deepseek-harness plugins",
    "type": "module",
    "scripts": {
        "check": "node scripts/check-host-pins.mjs",
        "check:pins": "node scripts/check-host-pins.mjs",
        "fix:pins": "node scripts/check-host-pins.mjs --fix",
        "build": "pnpm -r build",
        "typecheck": "pnpm -r typecheck",
        "test": "pnpm check:pins && pnpm -r test",
        "verify": "pnpm check:pins && pnpm -r typecheck && pnpm -r build && pnpm -r test"
    },
    "packageManager": "pnpm@12.0.0-rc.7"
}
