{
    "name": "@gitawego/dsh-llm-agy",
    "version": "0.2.0",
    "description": "Antigravity (agy) ACP provider for DeepSeek Harness at the ctx.llm adapter seam. Registers the `agy` route, drives `agy acp` over newline-delimited JSON-RPC, discovers models and thought levels from ACP config options, forwards image attachments as ACP image blocks, supports multiple Antigravity accounts with loopback Google sign-in, background token refresh, per-account quota, and one-click switching, and bridges ACP tool permissions to the harness approval service.",
    "type": "module",
    "main": "lib/index.js",
    "types": "lib/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "default": "./lib/index.js"
        },
        "./cordis.patch.yml": "./cordis.patch.yml",
        "./package.json": "./package.json",
        "./client": {
            "types": "./lib/types/client/index.d.ts",
            "default": "./lib/client.js"
        }
    },
    "files": [
        "lib",
        "cordis.patch.yml"
    ],
    "license": "MIT",
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "engines": {
        "node": ">=20"
    },
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "platform": "web",
            "inject": [
                "@deepseek-ai/dsh-client-locale",
                "@deepseek-ai/dsh-client-ui-renderer",
                "@deepseek-ai/dsh-client-ui-settings",
                "@deepseek-ai/dsh-client-ui-slots"
            ]
        }
    },
    "scripts": {
        "prepare": "npm run build",
        "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.client.json && node scripts/build-client.mjs",
        "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
        "test": "vitest run",
        "oauth-secret": "node scripts/antigravity-oauth-secret.mjs"
    },
    "peerDependencies": {
        "@deepseek-ai/cordis": "^4.1.0",
        "@deepseek-ai/dsh-host-webserver": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-agent": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-client-locale": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-client-ui-renderer": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-client-ui-settings": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-client-ui-slots": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-llm": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-session": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-user-approval": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-working-directory": "^0.2.2-rc.1",
        "@deepseek-ai/schemastery": "^3.19.0"
    },
    "devDependencies": {
        "@deepseek-ai/cordis": "^4.1.0",
        "@deepseek-ai/dsh-host-webserver": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-agent": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-client-locale": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-client-ui-renderer": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-client-ui-settings": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-client-ui-slots": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-llm": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-session": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-user-approval": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-working-directory": "^0.2.2-rc.1",
        "@deepseek-ai/schemastery": "^3.19.0",
        "@types/node": "^26.6.4",
        "@types/react": "~18.3.31",
        "esbuild": "^0.28.2",
        "react": "^18.3.1",
        "typescript": "^7.0.2",
        "vitest": "^5.0.3"
    },
    "peerDependenciesMeta": {
        "@deepseek-ai/dsh-host-webserver": {
            "optional": true
        }
    }
}
