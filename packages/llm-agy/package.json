{
    "name": "@gitawego/dsh-llm-agy",
    "version": "0.2.0",
    "description": "Antigravity (agy) ACP provider for DeepSeek Harness at the ctx.llm adapter seam. Registers the `agy` route, drives `agy acp` over newline-delimited JSON-RPC, discovers models and thought levels from ACP config options, and bridges ACP tool permissions to the harness approval service.",
    "type": "module",
    "main": "lib/index.js",
    "types": "lib/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "default": "./lib/index.js"
        },
        "./cordis.patch.yml": "./cordis.patch.yml",
        "./package.json": "./package.json"
    },
    "files": [
        "lib",
        "cordis.patch.yml"
    ],
    "license": "MIT",
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "engines": {
        "node": ">=20"
    },
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        }
    },
    "scripts": {
        "prepare": "npm run build",
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "peerDependencies": {
        "@deepseek-ai/cordis": "^4.1.0",
        "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
        "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
        "@deepseek-ai/dsh-session": "0.2.2-rc.1",
        "@deepseek-ai/dsh-user-approval": "0.2.2-rc.1",
        "@deepseek-ai/dsh-working-directory": "0.2.2-rc.1",
        "@deepseek-ai/schemastery": "^3.19.0"
    },
    "devDependencies": {
        "@deepseek-ai/cordis": "^4.1.0",
        "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
        "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
        "@deepseek-ai/dsh-session": "0.2.2-rc.1",
        "@deepseek-ai/dsh-user-approval": "0.2.2-rc.1",
        "@deepseek-ai/dsh-working-directory": "0.2.2-rc.1",
        "@deepseek-ai/schemastery": "^3.19.0",
        "@types/node": "^26.6.4",
        "typescript": "^7.0.2",
        "vitest": "^5.0.3"
    }
}
