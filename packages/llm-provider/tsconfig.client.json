{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "jsx": "react-jsx",
    "rootDir": "src",
    "outDir": ".client-build",
    "declaration": true,
    "declarationDir": "lib/types/client",
    "declarationMap": false,
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "react",
      "react-dom"
    ],
    "noEmitOnError": true,
    "paths": {
      "@deepseek-ai/dsh-client-store": [
        "./node_modules/@deepseek-ai/dsh-client-store/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-ui-renderer/client": [
        "./node_modules/@deepseek-ai/dsh-client-ui-renderer/lib/types/client/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-ui-settings": [
        "./node_modules/@deepseek-ai/dsh-client-ui-settings/lib/types/client/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-ui-settings/client": [
        "./node_modules/@deepseek-ai/dsh-client-ui-settings/lib/types/client/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-locale": [
        "./node_modules/@deepseek-ai/dsh-client-locale/lib/types/client/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-locale/client": [
        "./node_modules/@deepseek-ai/dsh-client-locale/lib/types/client/index.d.ts"
      ],
      "@deepseek-ai/dsh-api-remotes/client": [
        "./node_modules/@deepseek-ai/dsh-api-remotes/lib/types/client/index.d.ts"
      ],
      "@deepseek-ai/dsh-api-remotes/types": [
        "./node_modules/@deepseek-ai/dsh-api-remotes/lib/types/types.d.ts"
      ],
      "@deepseek-ai/dsh-api-gateway/client": [
        "./node_modules/@deepseek-ai/dsh-api-gateway/lib/types/client/index.d.ts"
      ],
      "@deepseek-ai/dsh-llm/types": [
        "./node_modules/@deepseek-ai/dsh-llm/lib/types/types.d.ts"
      ],
      "@deepseek-ai/dsh-settings/types": [
        "./node_modules/@deepseek-ai/dsh-settings/lib/types/types.d.ts"
      ],
      "@deepseek-ai/dsh-typert-protocol": [
        "./node_modules/@deepseek-ai/dsh-typert-protocol/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-ui-slots": [
        "./node_modules/@deepseek-ai/dsh-client-ui-slots/lib/types/index.d.ts"
      ]
    },
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "src/client/**/*.ts",
    "src/client/**/*.tsx"
  ],
  "exclude": [
    "lib",
    ".client-build",
    "node_modules"
  ]
}
