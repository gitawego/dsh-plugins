{
    "name": "@gitawego/dsh-llm-provider",
    "version": "0.2.0",
    "description": "OpenCode Go dashboard for DeepSeek Harness: live models versus the installed catalog, the route's enabled-model allowlist, and the subscription quota. The host dsh-llm-pi-ai adapter owns the route, endpoint, catalog, and session header; this plugin reports and writes only llm-pi-ai.providers.<route>.models.",
    "type": "module",
    "main": "lib/index.js",
    "types": "lib/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "default": "./lib/index.js"
        },
        "./cordis.patch.yml": "./cordis.patch.yml",
        "./package.json": "./package.json",
        "./client": {
            "types": "./lib/types/client/index.d.ts",
            "default": "./lib/client.js"
        }
    },
    "files": [
        "lib",
        "cordis.patch.yml"
    ],
    "license": "MIT",
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "engines": {
        "node": ">=20"
    },
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "platform": "web",
            "inject": [
                "@deepseek-ai/dsh-api-remotes",
                "@deepseek-ai/dsh-client-locale",
                "@deepseek-ai/dsh-client-ui-renderer",
                "@deepseek-ai/dsh-client-ui-settings",
                "@deepseek-ai/dsh-client-ui-settings-models",
                "@deepseek-ai/dsh-client-ui-tool"
            ]
        }
    },
    "scripts": {
        "prepare": "npm run build",
        "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.client.json && node scripts/build-client.mjs",
        "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
        "test": "vitest run"
    },
    "peerDependencies": {
        "@deepseek-ai/cordis": "^4.1.0",
        "@deepseek-ai/dsh-client-locale": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-client-ui-renderer": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-client-ui-settings": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-client-ui-slots": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-client-ui-tool": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-commands": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-credentials": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-host-webserver": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-llm": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-settings": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-tools": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-util-values": "^0.2.2-rc.1",
        "@deepseek-ai/schemastery": "^3.19.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@deepseek-ai/cordis": "^4.1.0",
        "@deepseek-ai/dsh-client-locale": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-client-ui-renderer": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-client-ui-settings": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-client-ui-slots": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-client-ui-tool": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-commands": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-credentials": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-host-webserver": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-llm": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-settings": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-tools": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-util-values": "^0.2.2-rc.1",
        "@deepseek-ai/schemastery": "^3.19.0",
        "@types/node": "^26.6.4",
        "@types/react": "~18.3.31",
        "@types/react-dom": "~18.3.7",
        "esbuild": "^0.28.2",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "typescript": "^7.0.2",
        "vitest": "^5.0.3"
    },
    "peerDependenciesMeta": {
        "@deepseek-ai/dsh-host-webserver": {
            "optional": true
        }
    }
}
