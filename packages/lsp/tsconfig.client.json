{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "rootDir": "src/client",
    "outDir": ".client-build",
    "declaration": true,
    "declarationDir": "lib/types/client",
    "declarationMap": false,
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["react", "react-dom"],
    "noEmitOnError": true,
    "paths": {
      "@deepseek-ai/dsh-client-runtime/client": ["./node_modules/@deepseek-ai/dsh-client-runtime/lib/types/client/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-slots": ["./node_modules/@deepseek-ai/dsh-client-ui-slots/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-tool": ["./node_modules/@deepseek-ai/dsh-client-ui-tool/lib/types/client/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-tool/client": ["./node_modules/@deepseek-ai/dsh-client-ui-tool/lib/types/client/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-settings": ["./node_modules/@deepseek-ai/dsh-client-ui-settings/lib/types/client/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-settings/client": ["./node_modules/@deepseek-ai/dsh-client-ui-settings/lib/types/client/index.d.ts"],
      "@deepseek-ai/dsh-client-locale": ["./node_modules/@deepseek-ai/dsh-client-locale/lib/types/client/index.d.ts"],
      "@deepseek-ai/dsh-client-locale/client": ["./node_modules/@deepseek-ai/dsh-client-locale/lib/types/client/index.d.ts"]
    }
  },
  "include": ["src/client/**/*.ts", "src/client/**/*.tsx"],
  "exclude": ["lib", ".client-build", "node_modules"]
}
